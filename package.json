{
	"name": "developlayout",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "husky",
		"setup:env": "node scripts/setup-env.mjs",
		"setup:env:check": "node scripts/setup-env.mjs --check",
		"db:backup": "node scripts/db-backup.mjs backup",
		"db:verify": "node scripts/db-backup.mjs verify",
		"db:restore": "node scripts/db-backup.mjs restore",
		"openapi:sync": "node scripts/openapi-sync.mjs",
		"openapi:types": "pnpm --filter ./projects/frontend run openapi:types",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\""
	},
	"lint-staged": {
		"projects/frontend/**/*.{ts,tsx}": [
			"pnpm --dir projects/frontend exec eslint --fix"
		],
		"projects/mobile/**/*.dart": [
			"sh -c 'cd projects/mobile && flutter analyze'"
		],
		"projects/backend/**/*.java": [
			"sh -c 'cd projects/backend && ./mvnw -q checkstyle:check'"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1"
	}
}
