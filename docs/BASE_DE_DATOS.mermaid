erDiagram
    usuario ||--o{ usuario_rol : "tiene"
    rol ||--o{ usuario_rol : "se asigna en"
    usuario ||--o{ sesion : "inicia"
    usuario |o..o{ bitacora : "genera (por usuario_codigo, sin FK)"

    usuario {
        BaseModel base "id, codigo_usuario, created_at, updated_at, deleted_at"
        varchar email "unico parcial, minusculas, no se actualiza"
        varchar password_hash "BCrypt"
        varchar estado "ACTIVO | INACTIVO"
        boolean invitacion_pendiente "aun no eligio su contrasena"
    }
    rol {
        BaseModel base "id, codigo_rol, created_at, updated_at, deleted_at"
        varchar nombre UK "SUPER_ADMIN, USUARIO"
        varchar descripcion
        boolean is_active
    }
    usuario_rol {
        BaseModel base "id, codigo_usuario_rol, created_at, updated_at, deleted_at"
        bigint usuario_id FK
        bigint rol_id FK
        boolean is_active
    }
    sesion {
        BaseModel base "id, codigo_sesion, created_at, updated_at, deleted_at"
        bigint usuario_id FK
        uuid usuario_codigo "para RLS, FK compuesta con usuario_id"
        varchar refresh_hash UK "sha256 hex del token vigente, nunca el token"
        varchar estado "ACTIVA | REVOCADA | EXPIRADA"
        varchar tipo_cliente "WEB | MOBILE"
        varchar ip
        varchar user_agent
        timestamptz expira_en
        timestamptz ultimo_uso_en
        timestamptz revocada_en
        varchar motivo_revocacion "LOGOUT | USUARIO | ADMIN | REUSO | RESET_PASSWORD | CAMBIO_PASSWORD"
    }
    bitacora {
        BaseModel base "id, codigo_bitacora, created_at, updated_at, deleted_at"
        uuid usuario_codigo "nullable"
        varchar accion
        varchar modulo
        varchar entidad
        uuid entidad_codigo "nullable"
        varchar resultado "EXITO | FALLO"
        varchar ip
        varchar user_agent
        jsonb detalle "sin datos sensibles"
    }

    system_metadata {
        varchar key PK
        text value
        timestamptz updated_at
    }
