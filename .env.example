# ==========================================
# INFRAESTRUCTURA GLOBAL
# ==========================================

# ---------------------------------------
# POSTGRESQL
# ---------------------------------------
POSTGRES_DB=app_db
POSTGRES_USER=app_admin
# Obligatorio, sin default. Generá uno propio: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAME

# ---------------------------------------
# REDIS
# ---------------------------------------
# Obligatorio: Redis siempre arranca con password.
REDIS_PASSWORD=CAMBIAME

# ---------------------------------------
# GRAFANA
# ---------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAME

# ---------------------------------------
# MINIO (S3 Local)
# ---------------------------------------
# MinIO exige MINIO_ROOT_USER >= 3 caracteres y MINIO_ROOT_PASSWORD >= 8 caracteres,
# si no el contenedor termina en "exited (1)".
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CAMBIAME

# Puerto del HOST donde se publica Postgres (por defecto 5432). Cambialo si ya tenes un Postgres local en 5432.
# POSTGRES_HOST_PORT=5433

# ==========================================
# SOLO PRODUCCIÓN (docker-compose.prod.yml)
# ==========================================
# Carpeta del servidor con fullchain.pem y privkey.pem del dominio.
# TLS_CERT_DIR=/etc/letsencrypt/live/midominio.com
# Origen(es) HTTPS del frontend, separados por coma.
# CORS_ALLOWED_ORIGINS=https://app.midominio.com
# Tag o digest FIJO de la imagen de MinIO (no usar latest).
# MINIO_IMAGE=
# Tag con el que se etiquetan las imágenes construidas (ej. el SHA del commit).
# APP_VERSION=latest
