# ==========================================
# BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

# Base de datos (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app_db
# La app corre con app_runtime (sin DDL, sin BYPASSRLS); Flyway, con el dueño.
SPRING_DATASOURCE_USERNAME=app_runtime
SPRING_DATASOURCE_PASSWORD=CAMBIAME
SPRING_FLYWAY_USER=app_admin
SPRING_FLYWAY_PASSWORD=CAMBIAME
# Misma contraseña que SPRING_DATASOURCE_PASSWORD (la usa la migración que crea el rol).
APP_RUNTIME_PASSWORD=CAMBIAME

# Administrador inicial (se crea una vez si no hay SUPER_ADMIN)
INITIAL_ADMIN_EMAIL=admin@midominio.com
INITIAL_ADMIN_PASSWORD=CAMBIAME

# Caché (Redis)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PASSWORD=CAMBIAME

# Almacenamiento (MinIO)
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CAMBIAME

# CORS (orígenes permitidos, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Swagger/OpenAPI: apagado por defecto (se enciende solo con el perfil dev)
# SWAGGER_ENABLED=false

# Clave para firmar los access token JWT (mínimo 32 caracteres; generar con `openssl rand -base64 48`).
JWT_SECRET=CAMBIAME_MINIMO_32_CARACTERES_ALEATORIOS

# Clave que firma los refresh tokens (mínimo 32 caracteres, DISTINTA de JWT_SECRET).
# Cambiarla cierra todas las sesiones.
REFRESH_TOKEN_SECRET=CAMBIAME_MINIMO_32_CARACTERES_ALEATORIOS
