<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada de la app va a backups en la nube ni a transferencias
     entre dispositivos (tokens y datos de sesión, MASVS-STORAGE). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
